# Copy to .env.local for local development, and add the same keys in
# Vercel > Project > Settings > Environment Variables for production.

# --- Supabase (Project Settings > API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx      # or the legacy "anon" key
SUPABASE_SECRET_KEY=sb_secret_xxx                            # or the legacy "service_role" key. SERVER ONLY.

# --- The site's public address (used in email links and Stripe/Sage redirects)
NEXT_PUBLIC_APP_URL=https://portal.bitstorage.ie

# EUR (Ireland, SEPA Direct Debit) or GBP (UK, Bacs Direct Debit)
NEXT_PUBLIC_CURRENCY=EUR

# --- Email (resend.com: verify your domain first) --------------------------
RESEND_API_KEY=re_xxx
EMAIL_FROM="BIT Storage <accounts@bitstorage.ie>"

# --- Stripe (Developers > API keys / Webhooks) -----------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Vercel Cron: any long random string. Vercel sends it automatically. ----
CRON_SECRET=change-me-to-a-long-random-string

# --- Sage Accounting (cloud) - optional. Sage 50 desktop uses CSV instead. --
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
